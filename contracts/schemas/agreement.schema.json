{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TISIIF agreement v1",
  "type": "object",
  "properties": {
    "ratings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string",
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5"
            ]
          },
          "label": {
            "type": "string",
            "enum": [
              "none",
              "partial",
              "core",
              "undetermined"
            ]
          },
          "rationale_md": {
            "type": "string"
          },
          "corresponding_elements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unable_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "candidate_id",
          "label",
          "rationale_md",
          "corresponding_elements",
          "unable_reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "ratings"
  ],
  "additionalProperties": false
}
