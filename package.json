{
  "name": "tisiif-free-lab",
  "version": "3.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 apps/web",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:sql": "node --import tsx tests/integration/database.ts",
    "test:stress": "node --import tsx tests/integration/stress.ts",
    "build": "node scripts/build-manifest.mjs && node scripts/assets.mjs && vite build apps/web",
    "bundle:edge": "node scripts/bundle-edge.mjs",
    "format": "prettier --write \"apps/web/src/**/*.{ts,tsx}\" \"packages/**/*.ts\" \"supabase/functions/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,tsx}\" \"packages/**/*.ts\" \"supabase/functions/**/*.ts\" \"tests/**/*.ts\"",
    "test:integration": "node scripts/test-integration.mjs",
    "verify:live": "node --import tsx scripts/live-smoke.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "5.3.1",
    "@noble/hashes": "1.8.0",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "katex": "0.19.1",
    "lucide-react": "1.61.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "deno": "2.9.6",
    "esbuild": "0.28.2",
    "prettier": "^3.6.2",
    "supabase": "2.122.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "katex": "0.19.1",
    "uuid": "11.1.1"
  }
}
