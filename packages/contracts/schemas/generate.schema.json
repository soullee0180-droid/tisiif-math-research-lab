{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TISIIF generate v1",
  "type": "object",
  "properties": {
    "ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string",
            "enum": [
              "I1",
              "I2",
              "I3",
              "I4",
              "I5"
            ]
          },
          "title": {
            "type": "string"
          },
          "idea_md": {
            "type": "string"
          },
          "why_helpful_md": {
            "type": "string"
          },
          "next_steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unverified_points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "candidate_id",
          "title",
          "idea_md",
          "why_helpful_md",
          "next_steps",
          "assumptions",
          "unverified_points"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "ideas"
  ],
  "additionalProperties": false
}
